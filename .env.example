# GROQ_API_KEY: Server-only Groq key used for the primary and fallback chat models.
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"
GROQ_TRANSCRIBE_MODEL="whisper-large-v3-turbo"

# Server-only Google Cloud service account with Text-to-Speech access.
GOOGLE_TTS_SERVICE_ACCOUNT_JSON='{"client_email":"tts-service-account@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'
GOOGLE_TTS_LANGUAGE_CODE="en-AU"
GOOGLE_TTS_VOICE_NAME="en-AU-Chirp3-HD-Algenib"
GOOGLE_TTS_SPEAKING_RATE="0.94"
GOOGLE_TTS_PITCH="-1"
GOOGLE_TTS_ENABLE_SSML="true"
# Optional server-only Voice settings. Keep the standard global endpoint unless
# latency measurements show a supported regional endpoint performs better.
GOOGLE_TTS_ENDPOINT="https://texttospeech.googleapis.com/v1/text:synthesize"
# Leave unset by default. Preview-only A/B testing may use one of:
# handset-class-device, headphone-class-device, small-bluetooth-speaker-class-device
# GOOGLE_TTS_AUDIO_PROFILE="handset-class-device"
# Hindi/Hinglish voice mapping remains server-owned; never accept a voice name from a client.
GOOGLE_TTS_HINDI_LANGUAGE_CODE="hi-IN"
GOOGLE_TTS_HINDI_VOICE_NAME="hi-IN-Standard-A"

# Per-endpoint persistent Voice limits. Defaults are 60 requests per 10 minutes
# for each Voice endpoint, with separate user and IP keys plus session limits.
VOICE_TRANSCRIBE_RATE_LIMIT="60"
VOICE_RESPOND_RATE_LIMIT="60"
VOICE_TTS_RATE_LIMIT="60"
VOICE_RATE_LIMIT_WINDOW_SECONDS="600"

VOICE_SESSION_MAX_MINUTES="10"
# End an untouched Voice reflection after this many seconds. Completed turns refresh it.
VOICE_IDLE_TIMEOUT_SECONDS="45"
# Voice minutes are reserved server-side by the private lease RPC. Defaults are
# 20 minutes per local reset day and 180 minutes per local reset month.
VOICE_DAILY_MAX_MINUTES="20"
VOICE_MONTHLY_MAX_MINUTES="180"
# Daily reset offset from UTC in minutes. 330 means midnight in India (IST).
VOICE_DAILY_RESET_OFFSET_MINUTES="330"

# VITE_SUPABASE_URL: Your Supabase Project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Your Supabase Anon Public Key
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Server-only key required for account deletion, rate limits, and entitlements.
# Never expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# RATE_LIMIT_IP_SALT: Server-only random value used to hash IP-based rate-limit keys.
RATE_LIMIT_IP_SALT="generate-a-long-random-value"

# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON: Server-only JSON credentials used to verify Android subscriptions.
# Grant the service account access to the Google Play Developer API for this app.
# Never expose this in client-side code.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"client_email":"service-account@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Required for native mobile builds so Capacitor calls your Vercel backend.
# Leave empty for same-origin web deploys.
VITE_API_BASE_URL="https://biblecompanion.vercel.app"

# VITE_APP_VERSION: Optional web UI version label; defaults to the current release version.
VITE_APP_VERSION="1.1.4"

# Release builds use bundled assets from dist. Enable this only for local live reload.
CAPACITOR_LIVE_RELOAD="false"
CAPACITOR_SERVER_URL="http://localhost:5173"

# Native Google Sign-In client IDs.
# VITE_GOOGLE_WEB_CLIENT_ID is required for Android native Google sign-in and also works as the iOS server client ID fallback.
# VITE_GOOGLE_IOS_CLIENT_ID is required for iOS native Google sign-in.
# VITE_GOOGLE_IOS_SERVER_CLIENT_ID is optional; when omitted the app reuses VITE_GOOGLE_WEB_CLIENT_ID.
VITE_GOOGLE_WEB_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
VITE_GOOGLE_IOS_CLIENT_ID="your-ios-client-id.apps.googleusercontent.com"
VITE_GOOGLE_IOS_SERVER_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"

# VITE_GOOGLE_PLAY_PUBLIC_KEY: Google Play monetization RSA public key.
# Public value used for Android billing / purchase-verification integrations when needed.
VITE_GOOGLE_PLAY_PUBLIC_KEY=""

# Native IAP product IDs for subscriptions.
# Use your App Store / Play Console product IDs.
VITE_IAP_MONTHLY_PRODUCT_ID="biblenova"
VITE_IAP_YEARLY_PRODUCT_ID="biblenovayearly"

# Android-only Google Play base plan IDs for the subscription products above.
VITE_IAP_MONTHLY_BASE_PLAN_ID="monthly"
VITE_IAP_MONTHLY_OFFER_ID="trial"
VITE_IAP_YEARLY_BASE_PLAN_ID="yearlyoffer"
