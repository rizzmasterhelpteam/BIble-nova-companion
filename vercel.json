{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run verify:production",
  "regions": ["sfo1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-API-Contract-Version", "value": "1" },
        { "key": "Access-Control-Expose-Headers", "value": "X-API-Contract-Version, X-Request-ID, Retry-After" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "microphone=(self), camera=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'sha256-o3vw7KF0LYKNNtUZ58Qzd+8ocOtmjWB0Ea1qS8Nrums=' 'sha256-pta9L383YDNHLzuJbaMg5YUk1Aznhej4FBbV8jv/12c=' 'wasm-unsafe-eval'; connect-src 'self' https://biblecompanion.vercel.app https://*.supabase.co wss://*.supabase.co https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com https://accounts.google.com; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self' https://accounts.google.com https://*.supabase.co; form-action 'self' https://accounts.google.com" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/voice/respond",
      "destination": "/api/chat?mode=voice"
    },
    {
      "source": "/api/status/ready",
      "destination": "/api/status?mode=ready"
    },
    {
      "source": "/api/subscription/status",
      "destination": "/api/status?mode=subscription-status"
    },
    {
      "source": "/api/subscription/native-sync",
      "destination": "/api/status?mode=subscription-native-sync"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
